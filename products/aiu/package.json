{
  "name": "@tjalve/aiu",
  "version": "0.0.9",
  "description": "AI Umpire package foundation and CLI for safe agent continuation.",
  "keywords": [
    "cli",
    "agent",
    "continuation",
    "umpire",
    "automation"
  ],
  "author": "tjalve",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZarK/ai-qube.git",
    "directory": "products/aiu"
  },
  "bugs": {
    "url": "https://github.com/ZarK/ai-qube/issues"
  },
  "homepage": "https://github.com/ZarK/ai-qube/tree/main/products/aiu#readme",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "aiu": "dist/src/bin/aiu.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./opencode": {
      "types": "./dist/src/opencode.d.ts",
      "import": "./dist/src/opencode.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "pack:dry-run": "pnpm pack --dry-run",
    "release:check": "pnpm run build && pnpm run typecheck && pnpm test && pnpm run pack:dry-run",
    "test": "pnpm run build && node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@tjalve/qube-adapter-claude-code": "0.1.5",
    "@tjalve/qube-adapter-codex": "0.1.7",
    "@tjalve/qube-adapter-grok-build": "0.1.7",
    "@tjalve/qube-adapter-opencode": "0.1.5",
    "@tjalve/qube-cli": "0.2.1",
    "@tjalve/qube-core": "0.2.5"
  }
}
