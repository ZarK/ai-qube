{
  "name": "@tjalve/qube-adapter-jira",
  "version": "0.1.0",
  "description": "Jira work provider adapter for QUBE issue reads, draft rendering, and unsupported lifecycle reporting.",
  "keywords": [
    "cli",
    "agent",
    "automation",
    "jira",
    "adapter"
  ],
  "type": "module",
  "license": "MIT",
  "author": "tjalve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZarK/ai-qube.git",
    "directory": "adapters/jira"
  },
  "bugs": {
    "url": "https://github.com/ZarK/ai-qube/issues"
  },
  "homepage": "https://github.com/ZarK/ai-qube/tree/main/adapters/jira#readme",
  "packageManager": "pnpm@11.0.4",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test \"test/*.test.mjs\"",
    "prepack": "pnpm run build",
    "verify": "pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@tjalve/qube-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "6.0.3"
  }
}
