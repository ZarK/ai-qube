  "findings": [
    {
      "id": "perf-publish-per-lane-reload",
      "severity": "advisory",
      "location": {
        "path": "products/aie/src/app/pr_gate.ts",
        "line": 973,
        "endLine": 992,
        "side": "destination"
      },
      "message": "The gate publish loop in pr_gate.ts sequentially awaits runPrReviewPublishWithProvider for every terminal local lane. Each call ends in GitHub publishLaneReviewFeedbackForPullRequest, which independently getIssueComments (paginated), getPullRequest, and rebuilds trustedLaneReviews for skip-match. On a full active-focus set this multiplies expensive provider reads by lane count after the gate already loaded the PR once. Separately, loadSiblingSynthesisLanes re-runs validateLaneEvidence for every other expected lane on every publish, so one gate that publishes L lanes performs roughly L² local evidence/provenance validations. Bound is the configured focus set (small but non-trivial), not repository size; still avoidable with one shared skip-match snapshot and one evidence cache per gate head.",
      "suggestion": "In the orchestrator multi-lane publish path, load comments/PR once (or pass a frozen ReviewItem into skip-match), cache validateLaneEvidence results by (issue, head, lane) for the gate invocation, and keep only the per-lane provider mutation sequential.",
      "confidence": 0.86
    }
  ],
